<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="appearance_background">#F6F8FB</color>
    <color name="appearance_surface">#FFFFFF</color>
    <color name="appearance_foreground">#172435</color>
    <color name="appearance_muted">#536174</color>
    <color name="appearance_border">#D8E0EA</color>
    <color name="appearance_tint">#EDF4FF</color>
    <color name="appearance_primary">#215CC3</color>
    <color name="appearance_on_primary">#FFFFFF</color>
    <color name="appearance_accent">#164EA9</color>
    <color name="appearance_disabled">#6B798B</color>
    <color name="appearance_ripple">#1A215CC3</color>
    <color name="appearance_scrim">#801B2638</color>
    <color name="appearance_dialog_primary_ripple">#20FFFFFF</color>

    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">@color/appearance_accent</item>
        <item name="android:colorControlActivated">@color/appearance_primary</item>
        <item name="android:colorControlNormal">@color/appearance_muted</item>
        <item name="android:colorControlHighlight">@color/appearance_ripple</item>
        <item name="android:colorBackgroundFloating">@color/appearance_surface</item>
        <item name="android:colorForeground">@color/appearance_foreground</item>
        <item name="android:textColorPrimary">@color/appearance_foreground</item>
        <item name="android:textColorSecondary">@color/appearance_muted</item>
        <item name="android:textColorHint">@color/appearance_muted</item>
        <item name="android:textColorLink">@color/appearance_accent</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:switchStyle">@style/AppSwitch</item>
        <item name="android:colorPrimary">@color/appearance_primary</item>
        <item name="android:colorPrimaryDark">@color/appearance_background</item>
        <item name="android:colorBackground">@color/appearance_background</item>
        <item name="android:windowBackground">@color/appearance_background</item>
        <item name="android:statusBarColor">@color/appearance_background</item>
        <item name="android:navigationBarColor">@color/appearance_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="AppDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">@color/appearance_accent</item>
        <item name="android:colorControlActivated">@color/appearance_primary</item>
        <item name="android:colorControlNormal">@color/appearance_muted</item>
        <item name="android:colorControlHighlight">@color/appearance_ripple</item>
        <item name="android:colorBackgroundFloating">@color/appearance_surface</item>
        <item name="android:colorForeground">@color/appearance_foreground</item>
        <item name="android:textColorPrimary">@color/appearance_foreground</item>
        <item name="android:textColorSecondary">@color/appearance_muted</item>
        <item name="android:textColorHint">@color/appearance_muted</item>
        <item name="android:textColorLink">@color/appearance_accent</item>
        <item name="android:switchStyle">@style/AppSwitch</item>
        <item name="android:colorBackground">@color/appearance_surface</item>
        <item name="android:windowBackground">@drawable/app_dialog_window</item>
        <item name="android:windowAnimationStyle">@style/AppDialogMotion</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AppDialogPrimaryAction</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AppDialogAction</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/AppDialogAction</item>
    </style>

    <style name="AppSwitch" parent="android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:textColor">@color/appearance_foreground</item>
    </style>
</resources>
