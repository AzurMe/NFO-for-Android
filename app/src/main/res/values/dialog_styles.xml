<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppDialogMotion" parent="android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/app_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/app_dialog_exit</item>
    </style>

    <style name="AppDialogAction" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/app_dialog_button_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/app_dialog_secondary_text</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="AppDialogPrimaryAction" parent="@style/AppDialogAction">
        <item name="android:background">@drawable/app_dialog_button_primary</item>
        <item name="android:textColor">@color/app_dialog_primary_text</item>
    </style>
</resources>
